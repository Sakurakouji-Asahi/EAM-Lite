# 此文件只是字段说明；真实文件由启动脚本写到 %LOCALAPPDATA%\EAM-Lite\local\。
EAM_VERSION=0.2.1
EAM_BUILD_COMMIT=replace-with-exact-commit
EAM_BUILD_TIME=replace-with-iso8601-time
EAM_APP_IMAGE=eam-lite-local:replace-with-exact-commit
EAM_POSTGRES_IMAGE=postgres:18.6-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
EAM_CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
EAM_DATABASE_NAME=eam_lite_local
POSTGRES_ADMIN_USER=eam_lite_admin
POSTGRES_MIGRATION_USER=eam_lite_migration
POSTGRES_RUNTIME_USER=eam_lite_runtime
EAM_SECRET_KEY_FILE=C:/Users/example/AppData/Local/EAM-Lite/local/secrets/secret_key.txt
EAM_DB_ADMIN_PASSWORD_FILE=C:/Users/example/AppData/Local/EAM-Lite/local/secrets/db_admin_password.txt
EAM_DB_MIGRATION_PASSWORD_FILE=C:/Users/example/AppData/Local/EAM-Lite/local/secrets/db_migration_password.txt
EAM_DB_RUNTIME_PASSWORD_FILE=C:/Users/example/AppData/Local/EAM-Lite/local/secrets/db_runtime_password.txt
EAM_BACKUP_KEY_FILE=C:/Users/example/AppData/Local/EAM-Lite/local/secrets/backup_key.txt
EAM_PORTABLE_PASSPHRASE_FILE=C:/Users/example/AppData/Local/EAM-Lite/local/tmp/passphrase-placeholder.txt
EAM_PORTABLE_OUTPUT_DIR=C:/Users/example/Documents/EAM-Lite备份
EAM_PORTABLE_BACKUP_FILE=C:/Users/example/AppData/Local/EAM-Lite/local/tmp/empty.eambak
