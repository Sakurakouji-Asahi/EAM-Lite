# 固定的逻辑服务 DNS 名称；不得填写服务器 IP、localhost 或个人电脑名。
# 更换服务器时只切换内部 DNS 指向，已经打印的二维码地址保持不变。
EAM_HOSTNAME=eam.company.lan
APP_COMMIT_SHA=replace-with-git-commit-sha
POSTGRES_DB=eam_lite
POSTGRES_ADMIN_USER=eam_lite_admin
POSTGRES_MIGRATION_USER=eam_lite_migration
POSTGRES_RUNTIME_USER=eam_lite_runtime
EAM_SECRET_KEY_FILE=C:/eam-lite-secrets/secret_key.txt
EAM_DB_ADMIN_PASSWORD_FILE=C:/eam-lite-secrets/db_admin_password.txt
EAM_DB_MIGRATION_PASSWORD_FILE=C:/eam-lite-secrets/db_migration_password.txt
EAM_DB_RUNTIME_PASSWORD_FILE=C:/eam-lite-secrets/db_runtime_password.txt
EAM_BACKUP_KEY_FILE=C:/eam-lite-secrets/backup_key.txt
BACKUP_MIRROR_HOST_PATH=//nas/eam-lite-backups
SECURE_HSTS_SECONDS=86400
