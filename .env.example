# EAM-Lite 直接读取进程环境变量；本文件只作为配置清单，不会被应用自动加载。
SECRET_KEY=replace-with-a-random-value-of-at-least-50-characters
# Docker Secret/受限文件方式可改用 SECRET_KEY_FILE，二者只能配置一个。
# SECRET_KEY_FILE=/run/secrets/secret_key
DEBUG=false
EAM_ENVIRONMENT=development

# 默认且推荐使用 PostgreSQL。SQLite 必须显式设置 DB_ENGINE=sqlite。
DB_ENGINE=postgresql
DB_NAME=eam_lite
DB_USER=eam_lite
DB_PASSWORD=replace-with-a-local-database-password
# DB_PASSWORD_FILE=/run/secrets/db_password
DB_HOST=127.0.0.1
DB_PORT=5432
# SQLITE_PATH=var/dev.sqlite3

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# 连续登录失败限速；均为正整数。第 N 次失败会审计，第 N+1 次被限制。
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_FAILURE_PAIR_LIMIT=5

STATIC_ROOT=var/static
# 受保护附件和临时上传必须位于 Web/static root 之外，且三者不得相同或互相嵌套。
MEDIA_ROOT=var/media
IMPORT_TEMP_ROOT=var/tmp
BUSINESS_CURRENCY=CNY
# 印入资产标签的固定内网 HTTPS 应用根地址；不得使用公网匿名地址。
QR_BASE_URL=https://eam.company.lan

# 生产 HTTPS 终止于受信任反向代理时应全部设为 true。
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
TRUST_PROXY_SSL_HEADER=false
TRUST_PROXY_CLIENT_IP=false
TRUSTED_PROXY_NETWORKS=
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=true

# 数据库与附件一致性备份；生产镜像目录必须位于独立设备/NAS。
BACKUP_ROOT=var/backups
BACKUP_TEMP_ROOT=var/backup-tmp
BACKUP_MIRROR_ROOT=
BACKUP_RETENTION_DAYS=30
BACKUP_DOWNLOAD_GRANT_MINUTES=10
BACKUP_RECENT_AUTH_MINUTES=15
BACKUP_MAX_AGE_HOURS=24
BACKUP_KEY_FILE=
BACKUP_PG_MODE=native
BACKUP_PG_DUMP_BIN=pg_dump
BACKUP_PG_RESTORE_BIN=pg_restore
BACKUP_DOCKER_BIN=docker
BACKUP_POSTGRES_CONTAINER=eam-lite-sprint0-pg
APP_COMMIT_SHA=unknown
